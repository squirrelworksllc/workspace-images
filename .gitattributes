# Default: let Git handle text files sanely
* text=auto

# Force LF for scripts
*.sh      text eol=lf
*.bash    text eol=lf

# Docker / CI / config files
Dockerfile        text eol=lf
*.dockerfile     text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf
*.json           text eol=lf
*.env            text eol=lf

# Markdown & docs
*.md      text eol=lf
*.rst     text eol=lf

# Shell & config fragments
*.conf    text eol=lf
*.ini     text eol=lf
*.service text eol=lf

# Vendored BitCurator assets (src/ubuntu/install/bitcurator5/vendor) - these
# get COPY'd straight into a Linux image and run as-is (shebangs, XDG desktop
# files, vim config); autocrlf must never touch them regardless of the OS
# checking this repo out.
*.py        text eol=lf
*.pl        text eol=lf
*.pm        text eol=lf
*.desktop   text eol=lf
*.directory text eol=lf
*.menu      text eol=lf
*.vimrc     text eol=lf
*.vim       text eol=lf
src/ubuntu/install/bitcurator5/vendor/usr-local-bin/* text eol=lf
src/ubuntu/install/bitcurator5/vendor/usr-sbin/*      text eol=lf
src/ubuntu/install/bitcurator5/vendor/env/nautilus-scripts/** text eol=lf
src/ubuntu/install/bitcurator5/vendor/env/ficlam.sh   text eol=lf